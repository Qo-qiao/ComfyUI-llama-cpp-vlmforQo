":"position","customSortAlphabet":"","toggleRestriction":"default","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.2"}},"color":"#432","bgcolor":"#653"},{"id":200,"type":"ShowText|pysssss","pos":[-1540,1190],"size":[580,670],"flags":{},"order":20,"mode":0,"inputs":[{"localized_name":"文本","name":"text","type":"STRING","link":364}],"outputs":[{"label":"字符串","localized_name":"字符串","name":"STRING","shape":6,"type":"STRING","links":null}],"properties":{"cnr_id":"comfyui-custom-scripts","ver":"609f3afaa74b2f88ef9ce8d939626065e3247469","Node name for S&R":"ShowText|pysssss","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["【正向约束】【下游模型】Z_image\n超写实真人质感，原生面部骨骼，眉眼唇轻微不对称，保留人种原生五官特征；妆后干净无瑕，保留毛孔与自然肌理，无过度磨皮与塑胶假肤、无AI模板脸；原生分层发丝，干净布景，专业模特姿态，真实情绪；所有风格分支均保持真人写实基线，姿态优雅克制\n\n1.人种五官轮廓特征：亚洲女性原生面部骨骼，眉眼唇轻微不对称，保留人种原生五官特征，无AI模板脸；妆后干净无瑕，保留毛孔与自然肌理；\n2.风格与服饰造型定位：文艺清新风格，日常休闲服饰，坐在教室内，姿态优雅克制；\n3.肤质与毛发原生细节：皮肤原生毛孔、自然肌理与细微皮肤纹理，拒绝过度磨皮；原生分层发丝，黑色长发根根分明；\n4.三维度镜头视角与构图：竖版人像（4:5）；微距特写至九分人像；正面略偏四分之三斜侧；平视视角；浅景深柔焦虚化，背景虚化奶油般化开，突出人物主体与环境氛围；\n5.姿态体态与表情神态：头部微侧，眼神聚焦看向镜头，神情柔和专注；躯干前倾放松，身体趴在桌子上，头枕在右边胳膊上；左手臂自然向前延伸到镜头处，手部轻触桌面；下肢姿态因坐姿蜷缩于桌下；嘴角弧度自然，眉宇情绪平静文艺；\n5.1 人像专属细节：眼神光为自然窗光（柔和反射）；肤质表现可见细微毛孔、丝绒柔滑；发丝质感根根分明；面部光影高光区位于额头与鼻梁，中间调面颊自然过渡，阴影区鼻翼侧立体；\n6.色彩配比与整体调性：主色调暖调占比70%，奠定清新基调；辅助色中性占比25%，丰富层次；点缀色低饱和占比5%，制造视觉焦点；色温情绪暖调（4000K）温馨亲切；饱和度低饱和高级文艺；肤色还原自然通透（健康血色）；\n7.专业布光方式与光影层次：主光类型为窗光网格投影；光源方向为侧逆光透过窗户照射，形成柔和轮廓光；光质软硬为柔光（渐变过渡阴影）；环境光补光比例适中，反光板效果柔和；\n8.背景与环境：虚化程度柔美光斑（f/2.8）；环境呼应教室窗框与书本色调统一；负空间眼神方向留白，头顶两侧留白；\n9.画面精简约束：无多余元素，专注人物神态与环境氛围融合；\n10.【技术参数建议】85mm中长焦，f/2.8光圈，1/250s快门，ISO400，背景虚化柔和，突出面部细节与发丝质感。\n\n【负向提示词】完美对称五官，过度磨皮，塑胶假肤，AI模板脸，僵硬摆拍，空洞假笑，肢体畸形，坏手多手指，画面杂乱，透视畸变，高饱和艳色，二次元卡通质感，曝光异常"]}],"links":[[364,242,0,200,0,"STRING"],[368,246,0,59,0,"STRING"],[374,250,0,113,0,"STRING"],[375,250,0,122,0,"STRING"],[381,254,0,203,0,"STRING"],[439,260,0,274,0,"LLAMACPPMODEL"],[440,274,0,242,0,"STRING"],[441,239,0,274,1,"LLAMACPPARAMS"],[442,262,0,275,0,"LLAM