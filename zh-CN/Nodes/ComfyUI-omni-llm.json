      "mmproj": "视觉编码模型",
      "enable_asr": "启用ASR",
      "n_ctx": "上下文长度",
      "n_gpu_layers": "GPU模型层数",
      "vram_limit": "显存限制（GB）",
      "image_max_tokens": "图片最大编码token数",
      "attention_type": "注意力类型",
      "tensor_split": "Tensor分割比例"
    },
    "outputs": {
      "llama_model": "Llama模型"
    },
    "tooltips": {
      "model": "选择要加载的LLM模型文件（GGUF格式）\n• 轻量级任务：Moondream2、MobileVLM\n• 中型任务：LLaVA-1.6、MiniCPM-V-4.5\n• 复杂任务：Qwen3-VL、GLM-4.6V",
      "enable_mmproj": "启用多模态功能（需要选择mmproj模型）\n• 处理图片或需要对话格式时设为True\n• 纯文本生成时设为False",
      "mmproj": "选择对应的视觉编码模型文件\n• 不同模型需要对应的mmproj文件\n• 确保版本匹配",
      "enable_asr": "启用ASR语音识别功能\n• 需要配合ASR模型加载器使用\n• 支持音频反推、语音转文本",
      "n_ctx": "上下文长度，影响可处理的文本长度\n• 24GB+显存：16384\n• 16GB显存：8192\n• 12GB显存：6144\n• 8GB显存：4096\n• 4-6GB显存：2048",
      "n_gpu_layers": "加载到GPU的模型层数\n• -1：全部加载（推荐）\n• GPU模式有效，CPU模式自动忽略\n• 显存不足时可设为部分层数",
      "vram_limit": "显存限制（GB）\n• -1：无限制\n• GPU模式有效，CPU模式自动忽略\n• 建议设为实际显存大小减1",
      "image_min_tokens": "图片最小编码token数\n• 保持默认0即可",
      "image_max_tokens": "图片最大编码token数\n• 保持默认0即可",
      "attention_type": "注意力类型\n• Auto：自动选择（推荐）\n• Standard：标准注意力\n• Flash：Flash Attention（NVIDIA GPU推荐）\n• XFormers：XFormers（实验性）",
      "cache_prompt": "缓存提示词\n• 启用后会缓存提示词以提高性能\n• 适用于重复使用相同提示词的场景",
      "tensor_split": "多GPU tensor分割比例\n• 格式：0.5,0.5（单GPU留空）\n• 仅多GPU时使用"
    }
  },
